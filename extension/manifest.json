{
  "manifest_version": 3,
  "name": "Nova Student Radar",
  "version": "1.1.0",
  "description": "Detecta beneficios estudiantiles publicados y revisados.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://nova-student-radar.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nova Student"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
