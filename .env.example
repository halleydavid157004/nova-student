PORT=4310
APP_BASE_URL=http://localhost:4310
ADMIN_TOKEN=change-me-now
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
DATABASE_PATH=./storage/nova-student.json
# Optional free persistent storage; set BOTH values on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Default after the Phase 1 migration. snapshot is for a documented rollback only.
SUPABASE_STORAGE_MODE=normalized
DEFAULT_TIMEZONE=America/Bogota
# Legacy value; the automatic radar now follows a fixed six-hour schedule.
SCAN_INTERVAL_MS=21600000
DIGEST_INTERVAL_MS=3600000

# Public integration bootstrap. Disable with false if you do not want it.
STUDENTOFFERS_DISCOVERY=true
# Leads from StudentOffers pages per radar cycle (robots.txt-compliant sitemap reader). 0–60.
STUDENTOFFERS_PAGES_PER_CYCLE=25
# Watch the curated list of official student pages in src/data/curated-sources.js.
NOVA_CURATED_SOURCES=true

# Optional: additional automatic discovery of fresh student-deal pages worldwide.
BRAVE_SEARCH_API_KEY=
# Shared monthly cap for discovery AND AI-assisted URL lookup; maximum 600.
BRAVE_MONTHLY_LIMIT=600

# Email option 1: Resend HTTP API (recommended for production).
RESEND_API_KEY=
RESEND_FROM="Nova Student <offers@yourdomain.com>"

# Email option 2: direct SMTP, including Gmail App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nova Student <your-email@gmail.com>"

# Successful verification age; shared with SQL/public view by the server. 1–90 days.
LIVENESS_MAX_AGE_DAYS=14
# Optional separate HMAC secret for report pseudonyms; server secrets are the fallback.
REPORT_HASH_SECRET=
# AI call allowance includes extraction retries and legacy lead extraction. 0–25.
LIVENESS_AI_CALLS_PER_CYCLE=12

# Switch only after GitHub Secrets + RADAR_ACTIONS_ENABLED=true are ready.
RADAR_ENGINE=render

# Phase 6: PUBLIC/publishable key only, never a secret/service_role key.
SUPABASE_PUBLISHABLE_KEY=
# Leave false until custom SMTP + exact callback URLs + privacy setup are verified.
SUPABASE_AUTH_ENABLED=false

# Keep Auth/public email off until a verified sender and privacy identity are ready.
EMAIL_TOKEN_SECRET=
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
