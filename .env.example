PORT=4310
APP_BASE_URL=http://localhost:4310
ADMIN_TOKEN=change-me-now
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
DATABASE_PATH=./storage/nova-student.json
# Optional free persistent storage; set BOTH values on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DEFAULT_TIMEZONE=America/Bogota
# Legacy value; the automatic radar now follows a fixed six-hour schedule.
SCAN_INTERVAL_MS=21600000
DIGEST_INTERVAL_MS=3600000

# Public integration bootstrap. Disable with false if you do not want it.
STUDENTOFFERS_DISCOVERY=true

# Optional: additional automatic discovery of fresh student-deal pages worldwide.
BRAVE_SEARCH_API_KEY=
# Shared monthly cap for discovery AND AI-assisted URL lookup; maximum 600.
BRAVE_MONTHLY_LIMIT=600

# Email option 1: Resend HTTP API (recommended for production).
RESEND_API_KEY=
RESEND_FROM="Nova Student <offers@yourdomain.com>"

# Email option 2: direct SMTP, including Gmail App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nova Student <your-email@gmail.com>"
